   "post": {
    "description": "Create a runtime deployment using the public docs payload: framework, venue, region, mode, name, code, config, credentials, alive_until, and on_expiry. Nautilus requests are planned internally and applied as NautilusTenantRuntime custom resources by unified-api.",
    "operationId": "createDeployment",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "additionalProperties": false,
        "properties": {
         "alive_until": {
          "format": "date-time",
          "type": "string"
         },
         "code": {
          "description": "Framework-native strategy source.",
          "type": "string"
         },
         "config": {
          "additionalProperties": true,
          "description": "Framework-native config.",
          "type": "object"
         },
         "credentials": {
          "additionalProperties": true,
          "description": "Credential metadata, normally {\"type\":\"managed\"}.",
          "type": "object"
         },
         "framework": {
          "enum": [
           "freqtrade",
           "nautilus"
          ],
          "type": "string"
         },
         "image_digest": {
          "description": "Optional pinned framework image digest.",
          "type": "string"
         },
         "mode": {
          "enum": [
           "paper",
           "live"
          ],
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "on_expiry": {
          "enum": [
           "stop",
           "block_entries"
          ],
          "type": "string"
         },
         "region": {
          "description": "Optional venue region, for example tokyo.",
          "type": "string"
         },
         "venue": {
          "description": "Venue id from /context/venues, for example hyperliquid.",
          "type": "string"
         }
        },
        "required": [
         "framework",
         "venue",
         "mode",
         "name",
         "code",
         "config"
        ],
        "type": "object"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "properties": {
          "created_at": {
           "type": "string"
          },
          "framework": {
           "type": "string"
          },
          "id": {
           "type": "string"
          },
          "mode": {
           "type": "string"
          },
          "status": {
           "type": "string"
          },
          "venue": {
           "type": "string"
          }
         },
         "type": "object"
        }
       }
      },
      "description": "Deployment created"
     }
    },
    "security": [
     {
      "ApiKeyAuth": []
     },
     {
      "BearerAuth": []
     }
    ],
    "summary": "Create a deployment"
   }
  },
