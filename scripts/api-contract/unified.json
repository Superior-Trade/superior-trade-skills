   "post": {
    "description": "Create Freqtrade backtests with legacy fields or Nautilus backtests that directly create GKE ConfigMap, NautilusBacktestRun, and Job resources from unified-api.",
    "operationId": "createBacktest",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "additionalProperties": true,
        "properties": {
         "datasetRef": {
          "additionalProperties": true,
          "type": "object"
         },
         "framework": {
          "type": "string"
         },
         "instruments": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "marketSlugs": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "strategy": {
          "type": "string"
         },
         "strategyConfig": {
          "additionalProperties": true,
          "type": "object"
         },
         "strategyId": {
          "type": "string"
         },
         "strategySource": {
          "type": "string"
         },
         "symbol": {
          "type": "string"
         },
         "tenantId": {
          "type": "string"
         },
         "timerange": {
          "additionalProperties": true,
          "type": "object"
         },
         "venue": {
          "type": "string"
         },
         "venueProfile": {
          "enum": [
           "polymarket-london",
           "lighter-tokyo",
           "lighter-robinhood-tokyo"
          ],
          "type": "string"
         }
        },
        "type": "object"
       }
      }
     },
     "required": true
    },
    "responses": {
     "202": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "properties": {
          "execution_cluster": {
           "type": "string"
          },
          "framework": {
           "type": "string"
          },
          "id": {
           "type": "string"
          },
          "k8s_job_name": {
           "type": "string"
          },
          "namespace": {
           "type": "string"
          },
          "planned_resources": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "result_uri": {
           "type": "string"
          },
          "status": {
           "type": "string"
          }
         },
         "type": "object"
        }
       }
      },
      "description": "Backtest accepted"
     }
    },
    "security": [
     {
      "ApiKeyAuth": []
     },
     {
      "BearerAuth": []
     }
    ],
    "summary": "List and create backtests"
